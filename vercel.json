{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/tmdb-image/:path*",
      "destination": "/api/tmdb-image?path=/:path*"
    },
    {
      "source": "/google*.html",
      "destination": "/google*.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
