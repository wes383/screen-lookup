{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/tmdb-image/:path*",
      "destination": "/api/tmdb-image?path=/:path*"
    },
    {
      "source": "/:file(google.*\\.html)",
      "destination": "/:file"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
